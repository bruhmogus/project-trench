# [AUTO_EN]
cmd-reset-ent-help = Usage: resetent <Entity UID>
# [AUTO_EN]
cmd-reset-ent-desc = Resets the entity to the last received state from the server. This also resets entities that were deleted in null-space.
# [AUTO_EN]
cmd-reset-all-ents-help = Usage: resetallents
# [AUTO_EN]
cmd-reset-all-ents-desc = Resets all entities to the last received server state. This affects only entities that were not deleted in null-space.
# [AUTO_EN]
cmd-detach-ent-help = Usage: detachent <Entity UID>
# [AUTO_EN]
cmd-detach-ent-desc = Removes an entity from null-space as if it had left the PVS area.
# [AUTO_EN]
cmd-local-delete-help = Usage: localdelete <Entity UID>
# [AUTO_EN]
cmd-local-delete-desc = Deletes an entity. Unlike the standard delete command, this command operates on the client side (CLIENT-SIDE). If the entity is not client-side, this will likely result in errors.
# [AUTO_EN]
cmd-full-state-reset-help = Usage: fullstatereset
# [AUTO_EN]
cmd-full-state-reset-desc = Resets all entity state information and requests full state from the server.
