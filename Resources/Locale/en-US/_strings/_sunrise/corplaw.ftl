# General Provisions
# [AUTO_EN]
corplaw-oprs-title = CORPLAW: Rights of Sentient Beings
# [AUTO_EN]
corplaw-oprs-desc =
    1. Right to life — the ability to exist and develop freely without threat to physical life.
    2. Right to freedom and personal security — guarantee of freedom of movement and absence of arbitrary arrests or detentions.
    3. Right to equality and non-discrimination — prohibition of any forms of discrimination based on race, gender, religion, nationality and other criteria.
    4. Right to protection from violence and exploitation — protection from physical and emotional violence, as well as from exploitation.
    5. Right to private life — guarantee of inviolability of personal life and protection from unlawful interference with it.
    6. Right to medical care — guarantee of provision of medical care in physical and mental fields.
# [AUTO_EN]
corplaw-opra-title = OPRA: Basic Rights of Reasonable Arrestees
# [AUTO_EN]
corplaw-opra-desc =
    1. Right to life — except for violators of 6XX articles.
    2. Right to protection of human dignity.
    3. Right to freedom of conscience and religion.
    4. Right to protection from violence.
    5. Right to private life — in free time for the arrested.
    6. Right to receive medical assistance.
# [AUTO_EN]
corplaw-sentences-title = General terms of imprisonment
# [AUTO_EN]
corplaw-sentences-desc =
    - Violation of articles [color=#30d158]1XX[/color] — warning, or a detention of [color=#ffd60a]5[/color] to [color=#ffd60a]10[/color] minutes.
    - Violation of articles [color=#ffd60a]2XX[/color] — warning, or a detention of [color=#ffd60a]10[/color] to [color=#ffd60a]20[/color] minutes.
    - Violation of articles [color=#ff9f0a]3XX[/color] — a detention of [color=#ff9f0a]15[/color] to [color=#ff9f0a]25[/color] minutes.
    - Violation of articles [color=#ff453a]4XX[/color] — a detention of [color=#ff453a]20[/color] to [color=#ff453a]35[/color] minutes.
    - Violation of articles [color=#bf5af2]5XX[/color] — a detention of [color=#bf5af2]30[/color] to [color=#bf5af2]50[/color] minutes.
    - Violation of articles [color=#ff375f]6XX[/color] — life imprisonment.
# [AUTO_EN]
corplaw-mitigating-title = Mitigating circumstances
# [AUTO_EN]
corplaw-mitigating-desc =
    - Cooperation and assistance in the investigation.
    - Absence of intent.
    - Good-faith admission of guilt.
    - Surrender.
    - Necessity (self-defense).
    - Being under hypnosis (after implantation of the Mind Shield).
# [AUTO_EN]
corplaw-aggravating-title = Aggravating circumstances
# [AUTO_EN]
corplaw-aggravating-desc =
    - Threat to the safety of the crew and station.
    - Professional incompetence.
    - Refusal to cooperate.
    - Severe consequences (damages, injuries).
    - Official crime (committed by a security officer or head).
    - Intent (revenge, attempt to conceal another crime).
    - Intoxication.
